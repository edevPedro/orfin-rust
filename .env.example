# Pluggy Open Finance credentials (https://dashboard.pluggy.ai)
PLUGGY_ID=your-client-id
PLUGGY_SECRET=your-client-secret

# PostgreSQL connection string
DATABASE_URL=postgres://orfin:orfin@localhost:5432/orfin

# Server
HOST=0.0.0.0
PORT=3000

# Public URL for Pluggy webhooks (must be HTTPS in production)
WEBHOOK_BASE_URL=https://your-domain.com
